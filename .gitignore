
# ============================================================
# Veridex - .gitignore
# ============================================================

# ------------------------------------------------------------
# 1. Environment Variables & Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
.pypirc
.streamlit/secrets.toml

# ------------------------------------------------------------
# 2. Python Bytecode & Cache
# ------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
*.sage.py
__pypackages__/

# ------------------------------------------------------------
# 3. Virtual Environments & Python Version Managers
# ------------------------------------------------------------
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pdm-python
.pixi/*
!.pixi/config.toml

# ------------------------------------------------------------
# 4. Build, Distribution & Packaging
# ------------------------------------------------------------
build/
dist/
downloads/
develop-eggs/
eggs/
.eggs/
*.egg-info/
*.egg
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST
.pdm-build/
.pybuilder/
target/
*.manifest
*.spec

# ------------------------------------------------------------
# 5. Testing, Coverage & Static Analysis
# ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
htmlcov/
cover/
*.cover
*.py.cover
*.lcov
coverage.xml
nosetests.xml
.dmypy.json
dmypy.json
cython_debug/

# ------------------------------------------------------------
# 6. IDE, Editor & OS
# ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
.spyderproject
.spyproject
.ropeproject
tempCodeRunnerFile.py

# ------------------------------------------------------------
# 7. Jupyter, IPython & Marimo
# ------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py
marimo/_static/
marimo/_lsp/
__marimo__/

# ------------------------------------------------------------
# 8. Logs & Temporary Files
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------
# 9. RAG Data, Documents & Vector Stores
# ------------------------------------------------------------
data/papers/
data/index/
data/chroma/
chroma_db/
chroma.sqlite3
*.faiss
*.index

# ------------------------------------------------------------
# 10. Generated Outputs & Reports
# ------------------------------------------------------------
outputs/
reports/generated/
scratch/

# ------------------------------------------------------------
# 11. Local Databases & App State
# ------------------------------------------------------------
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache
.abstra/

# ------------------------------------------------------------
# 12. Message Brokers & Background Workers
# ------------------------------------------------------------
celerybeat-schedule*
celerybeat.pid
*.rdb
*.aof
*.pid
mnesia/
rabbitmq/
rabbitmq-data/
activemq-data/

# ------------------------------------------------------------
# 13. Documentation & Static Site Builds
# ------------------------------------------------------------
docs/_build/
/site

# ------------------------------------------------------------
# 14. Miscellaneous Generated Files
# ------------------------------------------------------------
*.mo
*.pot
.scrapy/
