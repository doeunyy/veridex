# Copy to .env for local development. Never commit .env.
# On Cloud Run the three keys come from Secret Manager (see deploy/cloud_run.sh).

# LLM providers (exact model IDs verified with /models on 2026-10-21)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6.1-sol
GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash

# Embedding (corpus index and query embedding)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Real-time knowledge: Tavily Remote MCP (the key is sent as ?tavilyApiKey=)
TAVILY_API_KEY=tvly-...
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# Corpus v3 (built with scripts/corpus_v3.py; see docs/corpus_v3.md)
CORPUS_MANIFEST_PATH=./data/corpus_v3/papers.json
DOCUMENTS_DIR=./.artifacts/corpus_v3/papers
CHROMA_PERSIST_DIR=./.artifacts/corpus_v3/chroma
CHROMA_COLLECTION=veridex_corpus_v3
CATALOG_PATH=./.artifacts/corpus_v3/catalog.db

# Conversation state: sqlite locally, firestore on Cloud Run, memory for tests
STATE_BACKEND=sqlite
STATE_SQLITE_PATH=./.artifacts/state/conversations.db
FIRESTORE_PROJECT_ID=your-project-id
FIRESTORE_COLLECTION=veridex_conversations

# Orchestration limits
SUPERVISOR_MAX_HOPS=3
WORKER_MAX_TOOL_ROUNDS=4
WORKER_MAX_TOOL_CALLS=6
WORKER_MAX_TOOL_RESULT_CHARACTERS=8000
AGENT_HISTORY_TURNS=6
AGENT_MAX_COMPLETION_TOKENS=4096
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_MAX_RETRIES=0

# HTTP limits (per instance)
API_MAX_REQUEST_BODY_BYTES=65536
API_MAX_ACTIVE_REQUESTS=4
API_MAX_WAITING_REQUESTS=4
API_REQUEST_TIMEOUT_SECONDS=240
API_QUEUE_TIMEOUT_SECONDS=30

# Application
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080

# Cloud Run deployment (used by deploy/cloud_run.sh)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=veridex-v2
