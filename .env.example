# LLM
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# External search
TAVILY_API_KEY=your_tavily_api_key

# Application
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080

# HTTP limits (per process; total timeout includes queue/body/session-lock waits)
API_MAX_REQUEST_BODY_BYTES=65536
API_MAX_ACTIVE_REQUESTS=1
API_MAX_WAITING_REQUESTS=0
API_REQUEST_TIMEOUT_SECONDS=180
API_QUEUE_TIMEOUT_SECONDS=30

# Public demo budgets (local safeguards, not a hard spending guarantee)
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_CONTEXT_CHARACTERS=64000
AGENT_MAX_COMPLETION_TOKENS=4096
AGENT_MAX_SESSIONS=128
AGENT_SESSION_TTL_SECONDS=1800
AGENT_HISTORY_TURNS=6
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=0

# RAG
DOCUMENTS_DIR=./data/papers
CHROMA_PERSIST_DIR=./data/index
CHROMA_COLLECTION=veridex_documents

# MCP
MCP_SERVERS_CONFIG=./mcp_config.json
