# LLM
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# External search
TAVILY_API_KEY=your_tavily_api_key

# Application
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080

# RAG
DOCUMENTS_DIR=./data/papers
CHROMA_PERSIST_DIR=./data/index
CHROMA_COLLECTION=veridex_documents

# MCP
MCP_SERVERS_CONFIG=./mcp_config.json