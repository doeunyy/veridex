# Build context for the v2 image: source, pinned requirements and the Corpus v3 bundle.
.git
.github
.venv
.claude
.env
.env.*
!.env.example
.envrc
*.pem
*.key
.aws
.ssh
.agents
.codex

__pycache__
.pytest_cache
.ruff_cache
*.pyc
*.log
.DS_Store

# Anchored with "/" so gcloud does not also drop nested paths such as src/veridex/data.
/tests
/eval
/docs
/PROCESS_LOG.md
/submission_artifacts
/.docker-artifacts
/outputs
/scratch
/logs

# Only the manifest from data/, and only the built bundle from .artifacts/.
# (gitignore-style re-includes: parent directories must be re-included first.)
/data/*
!/data/corpus_v3
/data/corpus_v3/*
!/data/corpus_v3/papers.json
/.artifacts/*
!/.artifacts/corpus_v3
/.artifacts/corpus_v3/*
!/.artifacts/corpus_v3/papers
!/.artifacts/corpus_v3/chroma
!/.artifacts/corpus_v3/catalog.db
